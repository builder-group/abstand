		"feature-state": "^0.0.66",
		"lucide-react": "^1.14.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tailwind-merge": "^3.6.0",
		"tuple-result": "^0.0.12",
		"validation-adapters": "^0.0.38",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@blgc/config": "^0.0.42",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/router-plugin": "^1.167.35",
		"@tauri-apps/cli": "^2.11.1",
		"@types/node": "^25.7.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
