	},
	"license": "MIT",
	"author": "@bennobuilder",
	"type": "module",
	"scripts": {
		"build": "tauri build",
		"build:prod": "tauri build --config src-tauri/tauri.prod.conf.json",
		"clean": "shx rm -rf target && shx rm -rf dist && shx rm -rf .tanstack && shx rm -rf .turbo && shx rm -rf node_modules",
		"db:inspect": "cd src-tauri && atlas schema inspect --url 'file://src/modules/db/schema.sql' --dev-url 'sqlite://dev?mode=memory' -w",
		"db:migrate": "cd src-tauri && atlas migrate diff --env local",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"start:dev": "tauri dev",
		"test": "echo \"🧪 No tests defined yet.\"",
		"typecheck": "tsc --noEmit",
		"ui:build": "pnpm typecheck && vite build",
		"ui:start:dev": "vite dev",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@blgc/utils": "^0.0.62",
		"@tanstack/react-router": "^1.169.2",
		"@tanstack/react-router-devtools": "^1.166.13",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-os": "^2.3.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"feature-form": "^0.0.60",
